random_switch(FEAT_TRAINS, SELF, switch_electric_TRAXXF140MS2_random_all_2025) {
	3: switch_electric_TRAXXF140MS2_green_reversed;
    3: switch_electric_TRAXXF140MS2_red_reversed;
    2: switch_electric_TRAXXF140MS2_silver_reversed;
	2: switch_electric_TRAXXF140MS2_NMBS_reversed;
	1: switch_electric_TRAXXF140MS2_NMBS_Fenix_reversed;
	3: switch_electric_TRAXXF140MS2_NS_reversed;
	8: switch_electric_TRAXXF140MS2_Akiem_reversed;
	8: switch_electric_TRAXXF140MS2_Eurocity_reversed;
}
