switch(FEAT_TRAINS, SELF, switch_electric_Vectron_Vectron_reversed, train_is_driving_backwards) {
	0: spriteset_electric_Vectron_Vectron;	//Rear lights
	1: spriteset_REV_electric_Vectron_Vectron;//Front lights
}
