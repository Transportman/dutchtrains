/*
* LIVERY SELECTION
*/

random_switch(FEAT_TRAINS, SELF, switch_electric_Vectron_random_all) {
	5: switch_electric_Vectron_DBSchenker_reversed;
	5: switch_electric_Vectron_ELL_reversed;
	4: switch_electric_Vectron_MRCE_reversed;
	3: switch_electric_Vectron_NS_reversed;
	2: switch_electric_Vectron_PKP_reversed;
	2: switch_electric_Vectron_BLS_reversed;
	2: switch_electric_Vectron_SBB_reversed;
	2: switch_electric_Vectron_Captrain_reversed;
	1: switch_electric_Vectron_HUPAC_reversed;
	1: switch_electric_Vectron_Vectron_reversed;
}

random_switch(FEAT_TRAINS, SELF, switch_electric_Vectron_random_2018) {
	5: switch_electric_Vectron_DBSchenker_reversed;
	5: switch_electric_Vectron_ELL_reversed;
	4: switch_electric_Vectron_MRCE_reversed;
	2: switch_electric_Vectron_PKP_reversed;
	2: switch_electric_Vectron_BLS_reversed;
	2: switch_electric_Vectron_SBB_reversed;
	2: switch_electric_Vectron_Captrain_reversed;
	1: switch_electric_Vectron_HUPAC_reversed;
	1: switch_electric_Vectron_Vectron_reversed;
}

random_switch(FEAT_TRAINS, SELF, switch_electric_Vectron_random_2015) {
	5: switch_electric_Vectron_ELL_reversed;
	2: switch_electric_Vectron_MRCE_reversed;
	2: switch_electric_Vectron_PKP_reversed;
	2: switch_electric_Vectron_BLS_reversed;
}

random_switch(FEAT_TRAINS, SELF, switch_electric_Vectron_random_2016) {
	5: switch_electric_Vectron_ELL_reversed;
	3: switch_electric_Vectron_MRCE_reversed;
	2: switch_electric_Vectron_PKP_reversed;
	2: switch_electric_Vectron_BLS_reversed;
}

random_switch(FEAT_TRAINS, SELF, switch_electric_Vectron_random_2017) {
	5: switch_electric_Vectron_DBSchenker_reversed;
	5: switch_electric_Vectron_ELL_reversed;
	4: switch_electric_Vectron_MRCE_reversed;
	2: switch_electric_Vectron_PKP_reversed;
	2: switch_electric_Vectron_BLS_reversed;
	2: switch_electric_Vectron_SBB_reversed;
	1: switch_electric_Vectron_HUPAC_reversed;
}

switch(FEAT_TRAINS, SELF, switch_electric_Vectron_randomlivery, build_year) {
	0..2014: switch_electric_Vectron_ELL_reversed;
    2015: switch_electric_Vectron_random_2015;
	2016: switch_electric_Vectron_random_2016; 
	2017: switch_electric_Vectron_random_2017;
	2018..2019: switch_electric_Vectron_random_2018;
	switch_electric_Vectron_random_all;
}

switch(FEAT_TRAINS, SELF, switch_electric_Vectron_purchaselivery, build_year) {
	0..2014: switch_electric_Vectron_ELL_reversed;
	2015..2016: switch_electric_Vectron_MRCE_reversed;
	2017..2019: switch_electric_Vectron_DBSchenker_reversed;
	switch_electric_Vectron_NS_reversed;
}

switch(FEAT_TRAINS, SELF, switch_electric_Vectron_livery, cargo_subtype) {
	1: switch_electric_Vectron_purchaselivery;
    2: switch_electric_Vectron_Vectron_reversed;
    3: switch_electric_Vectron_BLS_reversed;
    4: switch_electric_Vectron_ELL_reversed;
	5: switch_electric_Vectron_DBSchenker_reversed;
	6: switch_electric_Vectron_PKP_reversed;
	7: switch_electric_Vectron_HUPAC_reversed;
	8: switch_electric_Vectron_Captrain_reversed;
	9: switch_electric_Vectron_MRCE_reversed;
	10: switch_electric_Vectron_SBB_reversed;
	11: switch_electric_Vectron_NS_reversed;
    switch_electric_Vectron_randomlivery;
}

// CARGO SUBTYPE CALLBACK
switch(FEAT_TRAINS, SELF, switch_electric_Vectron_subtype_text, cargo_subtype) {
    0: return string(str_cargo_subtype_random);
	1: return string(str_cargo_subtype_purchase);
    2: return string(str_cargo_subtype_Vectron);
    3: return string(str_cargo_subtype_BLS);
    4: return string(str_cargo_subtype_ELL);
    5: return string(str_cargo_subtype_DBSchenker);
    6: return string(str_cargo_subtype_PKP);
    7: return string(str_cargo_subtype_HUPAC);
    8: return string(str_cargo_subtype_Captrain);
    9: return string(str_cargo_subtype_MRCE);
    10: return string(str_cargo_subtype_SBB);
    11: return string(str_cargo_subtype_ns_flow);
    return CB_RESULT_NO_TEXT;
}

/*
* POWER CALLBACK
*/

switch(FEAT_TRAINS, SELF, switch_electric_Vectron_power, (railtype_available("SAAA") || railtype_available("SAAa")) ? (tile_powers_railtype("SAAA") || tile_powers_railtype("SAAa")) : (tile_powers_railtype("SAAE") || tile_powers_railtype("ELRL"))) {
	1: return 8582;
	return 4691;
}
