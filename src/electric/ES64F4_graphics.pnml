/*
* LIVERY SELECTION
*/

random_switch(FEAT_TRAINS, SELF, switch_electric_ES64F4_random_all) {
	1: switch_electric_ES64F4_dbs_reversed;
    1: switch_electric_ES64F4_ers_reversed;
    1: switch_electric_ES64F4_husa_reversed;
    1: switch_electric_ES64F4_locon_reversed;
    1: switch_electric_ES64F4_mrce_reversed;
    1: switch_electric_ES64F4_dispo_reversed;
    1: switch_electric_ES64F4_distri_reversed;
    1: switch_electric_ES64F4_rrf_reversed;
    1: switch_electric_ES64F4_veolia_reversed;
}

random_switch(FEAT_TRAINS, SELF, switch_electric_ES64F4_random_dbsers) {
	1: switch_electric_ES64F4_dbs_reversed;
    1: switch_electric_ES64F4_ers_reversed;
    1: switch_electric_ES64F4_mrce_reversed;
}

switch(FEAT_TRAINS, SELF, switch_electric_ES64F4_randomlivery, build_year) {
	0..2005: switch_electric_ES64F4_dbs_reversed;
    2006-2010: switch_electric_ES64F4_random_dbsers;
    switch_electric_ES64F4_random_all;
}

switch(FEAT_TRAINS, SELF, switch_electric_ES64F4_livery, cargo_subtype) {
    1: switch_electric_ES64F4_dbs_reversed;
    2: switch_electric_ES64F4_ers_reversed;
    3: switch_electric_ES64F4_husa_reversed;
    4: switch_electric_ES64F4_locon_reversed;
    5: switch_electric_ES64F4_mrce_reversed;
    6: switch_electric_ES64F4_dispo_reversed;
    7: switch_electric_ES64F4_distri_reversed;
    8: switch_electric_ES64F4_rrf_reversed;
    9: switch_electric_ES64F4_veolia_reversed;
    switch_electric_ES64F4_randomlivery;
}

// CARGO SUBTYPE CALLBACK
switch(FEAT_TRAINS, SELF, switch_electric_ES64F4_subtype_text, cargo_subtype) {
    0: return string(str_cargo_subtype_random);
    1: return string(str_cargo_subtype_DBSchenker);
    2: return string(str_cargo_subtype_ERS);
    3: return string(str_cargo_subtype_HUSA);
    4: return string(str_cargo_subtype_Locon);
    5: return string(str_cargo_subtype_MRCE);
    6: return string(str_cargo_subtype_Dispolok);
    7: return string(str_cargo_subtype_Distrirail);
    8: return string(str_cargo_subtype_rff);
    9: return string(str_cargo_subtype_Veolia);
    return CB_RESULT_NO_TEXT;
}

/*
* POWER CALLBACK
*/

switch(FEAT_TRAINS, SELF, switch_electric_ES64F4_power, (railtype_available("SAAA") || railtype_available("SAAa")) ? (tile_powers_railtype("SAAA") || tile_powers_railtype("SAAa")) : (tile_powers_railtype("SAAE") || tile_powers_railtype("ELRL"))) {
	1: return 8582;
	return 6034;
}