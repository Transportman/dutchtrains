switch(FEAT_TRAINS, SELF, switch_diesel_Class66_Veolia_reversed, train_is_driving_backwards) {
	0: spriteset_diesel_Class66_Veolia;	//Rear lights
	1: spriteset_REV_diesel_Class66_Veolia;//Front lights
}
switch(FEAT_TRAINS, SELF, switch_diesel_Class66_ACTS_reversed, train_is_driving_backwards) {
	0: spriteset_diesel_Class66_ACTS;	//Rear lights
	1: spriteset_REV_diesel_Class66_ACTS;//Front lights
}
