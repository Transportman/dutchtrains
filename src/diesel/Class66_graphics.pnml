/*
* LIVERY SELECTION
*/

random_switch(FEAT_TRAINS, SELF, switch_diesel_Class66_random) {
	1: switch_diesel_Class66_ACTS_reversed;
    1: switch_diesel_Class66_ACTS_2_reversed;
    1: switch_diesel_Class66_Captrain_reversed;
    1: switch_diesel_Class66_Crossrail_reversed;
    1: switch_diesel_Class66_DLC_reversed;
    1: switch_diesel_Class66_ERS_reversed;
    1: switch_diesel_Class66_HGK_reversed;
    1: switch_diesel_Class66_Rail4Chem_reversed;
    1: switch_diesel_Class66_Rail4Chem_2_reversed;
    1: switch_diesel_Class66_Veolia_reversed;
}

switch(FEAT_TRAINS, SELF, switch_diesel_Class66_livery, cargo_subtype) {
	1: switch_diesel_Class66_ACTS_reversed;
    2: switch_diesel_Class66_ACTS_2_reversed;
    3: switch_diesel_Class66_Captrain_reversed;
    4: switch_diesel_Class66_Crossrail_reversed;
    5: switch_diesel_Class66_DLC_reversed;
    6: switch_diesel_Class66_ERS_reversed;
    7: switch_diesel_Class66_HGK_reversed;
    8: switch_diesel_Class66_Rail4Chem_reversed;
    9: switch_diesel_Class66_Rail4Chem_2_reversed;
    10: switch_diesel_Class66_Veolia_reversed;
    switch_diesel_Class66_random;
}

// CARGO SUBTYPE CALLBACK
switch(FEAT_TRAINS, SELF, switch_diesel_Class66_subtype_text, cargo_subtype) {
    0: return string(str_cargo_subtype_random);
	1: return string(str_cargo_subtype_ACTS_blue_yellow);
    2: return string(str_cargo_subtype_ACTS_grey_green);
    3: return string(str_cargo_subtype_Captrain);
    4: return string(str_cargo_subtype_Crossrail);
    5: return string(str_cargo_subtype_DLC);
    6: return string(str_cargo_subtype_ERS);
    7: return string(str_cargo_subtype_HGK);
    8: return string(str_cargo_subtype_Rail4Chem_green);
    9: return string(str_cargo_subtype_Rail4Chem_grey_yellow);
    10: return string(str_cargo_subtype_Veolia_black);
    return CB_RESULT_NO_TEXT;
}
