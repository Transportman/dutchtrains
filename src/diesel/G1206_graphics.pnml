switch(FEAT_TRAINS, SELF, switch_diesel_G1206_Rail4Chem_2_reversed, train_is_driving_backwards) {
	0: spriteset_diesel_G1206_Rail4Chem_2;	//Rear lights
	1: spriteset_REV_diesel_G1206_Rail4Chem_2;//Front lights
