switch(FEAT_TRAINS, SELF, switch_diesel_G1206_Veolia_reversed, train_is_driving_backwards) {
	0: spriteset_diesel_G1206_Veolia;	//Rear lights
	1: spriteset_REV_diesel_G1206_Veolia;//Front lights
}
switch(FEAT_TRAINS, SELF, switch_diesel_G1206_ERS_reversed, train_is_driving_backwards) {
	0: spriteset_diesel_G1206_ERS;	//Rear lights
	1: spriteset_REV_diesel_G1206_ERS;//Front lights
}
switch(FEAT_TRAINS, SELF, switch_diesel_G1206_Rail4Chem_reversed, train_is_driving_backwards) {
	0: spriteset_diesel_G1206_Rail4Chem;	//Rear lights
	1: spriteset_REV_diesel_G1206_Rail4Chem;//Front lights
}
switch(FEAT_TRAINS, SELF, switch_diesel_G1206_Veolia_2_reversed, train_is_driving_backwards) {
