switch(FEAT_TRAINS, SELF, switch_diesel_G2000_Rail4Chem_reversed, train_is_driving_backwards) {
	0: spriteset_diesel_G2000_Rail4Chem;	//Rear lights
	1: spriteset_REV_diesel_G2000_Rail4Chem;//Front lights
}
switch(FEAT_TRAINS, SELF, switch_diesel_G2000_Railion_reversed, train_is_driving_backwards) {
	0: spriteset_diesel_G2000_Railion;	//Rear lights
	1: spriteset_REV_diesel_G2000_Railion;//Front lights
}
switch(FEAT_TRAINS, SELF, switch_diesel_G2000_ERS_reversed, train_is_driving_backwards) {
	0: spriteset_diesel_G2000_ERS;	//Rear lights
	1: spriteset_REV_diesel_G2000_ERS;//Front lights
}
switch(FEAT_TRAINS, SELF, switch_diesel_G2000_rurtalbahn_black_reversed, train_is_driving_backwards) {
	0: spriteset_diesel_G2000_rurtalbahn_black;	//Rear lights
	1: spriteset_REV_diesel_G2000_rurtalbahn_black;//Front lights
}
switch(FEAT_TRAINS, SELF, switch_diesel_G2000_rurtalbahn_blue_reversed, train_is_driving_backwards) {
	0: spriteset_diesel_G2000_rurtalbahn_blue;	//Rear lights
	1: spriteset_REV_diesel_G2000_rurtalbahn_blue;//Front lights
}
switch(FEAT_TRAINS, SELF, switch_diesel_G2000_rff_reversed, train_is_driving_backwards) {
	0: spriteset_diesel_G2000_rff;	//Rear lights
	1: spriteset_REV_diesel_G2000_rff;//Front lights
}
switch(FEAT_TRAINS, SELF, switch_diesel_G2000_rts_black_reversed, train_is_driving_backwards) {
	0: spriteset_diesel_G2000_rts_black;	//Rear lights
	1: spriteset_REV_diesel_G2000_rts_black;//Front lights
}
switch(FEAT_TRAINS, SELF, switch_diesel_G2000_rts_orange_reversed, train_is_driving_backwards) {
	0: spriteset_diesel_G2000_rts_orange;	//Rear lights
	1: spriteset_REV_diesel_G2000_rts_orange;//Front lights
}

/*
* LIVERY SELECTION
*/

random_switch(FEAT_TRAINS, SELF, switch_diesel_G2000_randomlivery) {
	1: switch_diesel_G2000_Rail4Chem_reversed;
    1: switch_diesel_G2000_Railion_reversed;
    1: switch_diesel_G2000_ERS_reversed;
    1: switch_diesel_G2000_rurtalbahn_black_reversed;
    1: switch_diesel_G2000_rurtalbahn_blue_reversed;
    1: switch_diesel_G2000_rff_reversed;
    1: switch_diesel_G2000_rts_black_reversed;
    1: switch_diesel_G2000_rts_orange_reversed;
}

switch(FEAT_TRAINS, SELF, switch_diesel_G2000_livery, cargo_subtype) {
	1: switch_diesel_G2000_Rail4Chem_reversed;
    2: switch_diesel_G2000_Railion_reversed;
    3: switch_diesel_G2000_ERS_reversed;
    4: switch_diesel_G2000_rurtalbahn_black_reversed;
    5: switch_diesel_G2000_rurtalbahn_blue_reversed;
    6: switch_diesel_G2000_rff_reversed;
    7: switch_diesel_G2000_rts_black_reversed;
    8: switch_diesel_G2000_rts_orange_reversed;
    switch_diesel_G2000_randomlivery;
}

// CARGO SUBTYPE CALLBACK
switch(FEAT_TRAINS, SELF, switch_diesel_G2000_subtype_text, cargo_subtype) {
    0: return string(str_cargo_subtype_random);
	1: return string(str_cargo_subtype_Rail4Chem_green);
    2: return string(str_cargo_subtype_Railion_red);
    3: return string(str_cargo_subtype_ERS);
    4: return string(str_cargo_subtype_rurtalbahn_black);
    5: return string(str_cargo_subtype_rurtalbahn_blue);
    6: return string(str_cargo_subtype_rff);
    7: return string(str_cargo_subtype_rts_black);
    8: return string(str_cargo_subtype_rts_orange);
    return CB_RESULT_NO_TEXT;
}
